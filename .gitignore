# --- Virtual environments ---
.venv/
venv/
env/

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Python cache / bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- Build / packaging artifacts ---
build/
dist/
*.egg-info/
.eggs/

# --- Test / coverage / lint caches ---
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Logs ---
*.log
logs/

# --- Local databases ---
*.db
*.sqlite
*.sqlite3

# --- Large local data / generated datasets ---
data/
# Allow an explicitly committed small sample set later:
!data/samples/
!data/samples/**
# ...but NEVER commit raw address-level DVF/DPE records, even if placed elsewhere:
data/raw/
*.csv.gz
data/raw/dpe/*.json
# Processed datasets are regenerated artifacts, never committed:
data/processed/
*.parquet
# Machine-readable discovery/quality profiles (regenerated artifacts):
docs/data-discovery/profile_output.json

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo

# --- OS-generated ---
.DS_Store
Thumbs.db
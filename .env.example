# Environment variable template for Real Estate Investment Intelligence Agent — Paris.
#
# Copy this file to .env and replace placeholder values when required.
# .env is git-ignored and must never be committed.

# --- Database (Phase 3 — PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://real_estate_app:CHANGE_ME@localhost:5432/real_estate_db
TEST_DATABASE_URL=postgresql+psycopg://real_estate_app:CHANGE_ME@localhost:5432/real_estate_test

# --- Local application (Phase 5 — FastAPI + Streamlit) ---
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=15

# --- LLM provider (introduced in later AI phases) ---
# LLM_API_KEY=

# --- Embeddings provider (introduced in Phase 6 — RAG) ---
# EMBEDDINGS_API_KEY=

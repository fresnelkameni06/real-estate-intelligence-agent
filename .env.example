# Environment variable template for Real Estate Investment Intelligence Agent — Paris.
#
# Copy this file to `.env` and fill in real values ONLY when a given phase needs them.
# `.env` is git-ignored and must never be committed.
#
# Phase 0 (current) does not require any secrets.

# --- Database (introduced in Phase 3 — PostgreSQL) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/real_estate

# --- LLM provider (introduced in later AI phases) ---
# LLM_API_KEY=

# --- Embeddings provider (introduced in Phase 6 — RAG) ---
# EMBEDDINGS_API_KEY=